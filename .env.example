# Use 127.0.0.1, not localhost: on some machines `localhost` resolves to the
# IPv6 address ::1 first, and Postgres may only be listening on IPv4.
PGHOST=127.0.0.1

# 5432 is the default. If you installed Postgres more than once, the one you
# are actually using may be on 5433 - check pgAdmin or your installer.
PGPORT=5432

PGDATABASE=bookshop
PGUSER=postgres

# The password you chose when you installed Postgres.
# If it contains a # you MUST quote it, or everything after the # is dropped:
#   PGPASSWORD="my#password"
PGPASSWORD=your-local-password
